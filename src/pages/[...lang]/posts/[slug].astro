---
import { getLangRouteParam } from '@/i18n/lang'
import Layout from '@/layouts/Layout.astro'
import { getWordPressPost, getWordPressPostPaths } from '@/utils/wordpress'

export async function getStaticPaths() {
  const paths = await getWordPressPostPaths()
  return paths.map(post => ({ params: { lang: getLangRouteParam('zh'), slug: post.slug } }))
}

const slug = Astro.params.slug ?? ''
const post = await getWordPressPost(slug)
if (!post) throw new Error(`WordPress post not found: ${slug}`)
---

<Layout postTitle={post.title} postDescription={post.excerpt} postSlug={post.slug}>
  <article class="heti wordpress-article">
    <p class="eyebrow">WRITING</p>
    <h1 class="post-title">{post.title}</h1>
    <time class="post-meta" datetime={post.date}>{new Date(post.date).toLocaleDateString('zh-CN')}</time>
    {post.image && <img class="article-cover" src={post.image.src} alt={post.image.alt} width={post.image.width} height={post.image.height} loading="eager" />}
    <div id="post-content" class="wordpress-content" set:html={post.content} />
  </article>
</Layout>
