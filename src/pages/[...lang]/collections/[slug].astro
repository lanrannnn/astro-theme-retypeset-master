---
import { getLangRouteParam } from '@/i18n/lang'
import { getLocalizedPath } from '@/i18n/path'
import Layout from '@/layouts/Layout.astro'
import { getWordPressCollection, getWordPressCollections } from '@/utils/wordpress'

export async function getStaticPaths() {
  const collections = await getWordPressCollections()
  return collections.map(collection => ({ params: { lang: getLangRouteParam('zh'), slug: collection.slug } }))
}

const slug = Astro.params.slug ?? ''
const collection = await getWordPressCollection(slug)
if (!collection) throw new Error(`WordPress collection not found: ${slug}`)
---

<Layout postTitle={collection.title} postDescription={collection.description}>
  <article class="heti archive-page">
    <p class="eyebrow">COLLECTION · NO. 45</p>
    <h1>{collection.title}</h1>
    <p class="archive-lead">{collection.description}</p>
    <ol class="archive-list numbered-list">
      {collection.posts.map((post, index) => (
        <li>
          <a href={getLocalizedPath(`/posts/${post.route}`)}>
            <span class="list-index">{String(index + 1).padStart(2, '0')}</span>
            <span class="archive-title">{post.title}</span>
            <time datetime={post.date}>{new Date(post.date).toLocaleDateString('zh-CN')}</time>
          </a>
        </li>
      ))}
    </ol>
  </article>
</Layout>
